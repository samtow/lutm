{
  "name": "lutm-build-status",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node preview.mjs",
    "deploy": "node bundle-assets.mjs && convex deploy",
    "check": "node bundle-assets.mjs && convex codegen && convex deploy --dry-run",
    "launch": "node launch.mjs",
    "test": "python3 -m unittest discover -s . -p 'test_*.py' && node --test *.test.mjs"
  },
  "dependencies": {
    "@depot/sandbox": "0.1.0-beta.4",
    "convex": "1.46.0"
  }
}
